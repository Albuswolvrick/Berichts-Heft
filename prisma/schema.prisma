// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
  TRAINEE
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REVISION_REQUIRED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  role         UserRole @default(TRAINEE)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dailyReports   DailyReport[]
  weeklyReports  WeeklyReport[]
  monthlyReports MonthlyReport[]
  yearlyReports  YearlyReport[]
  comments       Comment[]

  @@index([email])
}

model DailyReport {
  id             Int           @id @default(autoincrement())
  userId         Int
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyReportId Int?
  weeklyReport   WeeklyReport? @relation(fields: [weeklyReportId], references: [id], onDelete: SetNull)
  reportDate     DateTime
  title          String
  activities     String
  learnings      String
  challenges     String
  hoursWorked    Float
  status         ReportStatus  @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  attachments    Attachment[]
  comments       Comment[]

  @@index([userId])
  @@index([weeklyReportId])
  @@index([reportDate])
  @@index([status])
}

model WeeklyReport {
  id              Int            @id @default(autoincrement())
  userId          Int
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyReportId Int?
  monthlyReport   MonthlyReport? @relation(fields: [monthlyReportId], references: [id], onDelete: SetNull)
  name            String?
  weekStart       DateTime?
  weekEnd         DateTime?
  weekNumber      Int?
  department      String?
  yearOfTraining  Int?
  summary         String?
  activities      String?
  school          String?
  totalHours      Float?
  remarks         String?
  status          ReportStatus   @default(DRAFT)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  dailyReports    DailyReport[]
  attachments     Attachment[]
  comments        Comment[]

  @@index([userId])
  @@index([monthlyReportId])
  @@index([weekStart, weekEnd])
  @@index([status])
}

model MonthlyReport {
  id              Int            @id @default(autoincrement())
  userId          Int
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  yearlyReportId  Int?
  yearlyReport    YearlyReport?  @relation(fields: [yearlyReportId], references: [id], onDelete: SetNull)
  month           Int
  year            Int
  monthStart      DateTime
  monthEnd        DateTime
  summary         String
  keyAchievements String
  goals           String
  totalHours      Float
  yearOfTraining  Int?
  name            String
  instructions    String
  remarks         String
  status          ReportStatus   @default(DRAFT)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  weeklyReports   WeeklyReport[]
  attachments     Attachment[]
  comments        Comment[]

  @@index([userId])
  @@index([yearlyReportId])
  @@index([month, year])
  @@index([status])
}

model YearlyReport {
  id             Int             @id @default(autoincrement())
  userId         Int
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  year           Int
  trainingYear   String
  yearStart      DateTime
  yearEnd        DateTime
  summary        String
  achievements   String
  skillsImproved String
  goals          String
  totalHours     Float
  status         ReportStatus    @default(DRAFT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  monthlyReports MonthlyReport[]
  attachments    Attachment[]
  comments       Comment[]

  @@index([userId])
  @@index([year])
  @@index([status])
}

model Attachment {
  id              Int            @id @default(autoincrement())
  dailyReportId   Int?
  dailyReport     DailyReport?   @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  weeklyReportId  Int?
  weeklyReport    WeeklyReport?  @relation(fields: [weeklyReportId], references: [id], onDelete: Cascade)
  monthlyReportId Int?
  monthlyReport   MonthlyReport? @relation(fields: [monthlyReportId], references: [id], onDelete: Cascade)
  yearlyReportId  Int?
  yearlyReport    YearlyReport?  @relation(fields: [yearlyReportId], references: [id], onDelete: Cascade)
  fileName        String
  filePath        String
  fileSize        Int?
  mimeType        String?
  uploadedAt      DateTime       @default(now())

  @@index([dailyReportId])
  @@index([weeklyReportId])
  @@index([monthlyReportId])
  @@index([yearlyReportId])
}

model Comment {
  id              Int            @id @default(autoincrement())
  userId          Int
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyReportId   Int?
  dailyReport     DailyReport?   @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  weeklyReportId  Int?
  weeklyReport    WeeklyReport?  @relation(fields: [weeklyReportId], references: [id], onDelete: Cascade)
  monthlyReportId Int?
  monthlyReport   MonthlyReport? @relation(fields: [monthlyReportId], references: [id], onDelete: Cascade)
  yearlyReportId  Int?
  yearlyReport    YearlyReport?  @relation(fields: [yearlyReportId], references: [id], onDelete: Cascade)
  content         String
  createdAt       DateTime       @default(now())

  @@index([userId])
  @@index([dailyReportId])
  @@index([weeklyReportId])
  @@index([monthlyReportId])
  @@index([yearlyReportId])
}
